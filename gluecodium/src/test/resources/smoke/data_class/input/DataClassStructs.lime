package smoke

enum PlaceType {
    POI,
    AREA,
    STREET
}

@Immutable
@Equatable
@Kotlin(DataClass)
struct Place {
    title: String
    id: String
    place_type: PlaceType
    latitude: Double
    longitude: Double
    distance_in_meters: Int? = null
    political_view: String? = null

    fun serialize_compact(): String

    static fun deserialize(serialized_place: String): Place
}

enum SuggestionType {
    CATEGORY,
    CHAIN,
    PLACE
}

@Immutable
@Kotlin(DataClass)
struct Suggestion {
    title: String
    type: SuggestionType
    place: Place? = null
    id: String? = null
    href: String? = null

    fun getHighlights(): Map<String, List<Int>>
}
